<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>WidgetsProgram</StartupObject><AssemblyName>Clean11.Widgets</AssemblyName><PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>../Clean11.Dock/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Clean11.Dock/*.cs"/>
    <Compile Include="../Clean11.Launcher/StartupRegistration.cs"/>
    <Compile Include="../Clean11.Overview/Clean11Paths.cs;../Clean11.Overview/OverviewScene.cs;../Clean11.Overview/Clean11Fluent.cs;../Clean11.Overview/ActivityTheme.cs;../Clean11.Overview/OverviewPreferences.cs;../Clean11.Overview/FrostedMaterial.cs;../Clean11.Overview/DockBackdrop.cs;../Clean11.Overview/DockComposition.cs"/><Compile Include="JsonCompatibility.cs"/>
    <PackageReference Include="WPF-UI" Version="4.3.0"/>
    <None Include="../Clean11.Overview/ActivitiesTheme.json" Link="ActivitiesTheme.json" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../Clean11.Dock/Tray/style.css" Link="tray.css" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
