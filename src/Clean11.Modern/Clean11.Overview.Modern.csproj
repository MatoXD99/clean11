<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>Program</StartupObject><AssemblyName>ActivitiesOverview</AssemblyName><PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>../Clean11.Dock/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Clean11.Overview/*.cs"/><Compile Include="JsonCompatibility.cs"/>
    <PackageReference Include="WPF-UI" Version="4.3.0"/>
    <None Include="../Clean11.Overview/ActivitiesTheme.json" Link="ActivitiesTheme.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
